is_locked() {
  [[ ! -L "$1" && -e "$1" && ! "$(lsattr -d $1 2>/dev/null)" ]] && return 0
  if [[ ! -L "$1" && -e "$1" && "$(lsattr -d $1 2>/dev/null)" &&  "$(lsattr -d $1 | cut -c 5 2>/dev/null)" == "i" ]]; then 
    return 0
  else
    return 1
  fi
}

smux() {
    local MUXDIR="~/.tmux-sessions"
    if is_locked "${MUXDIR}"; then
        sudo chattr -i "${MUXDIR}"
        chmod 770 "${MUXDIR}"
        tmux -S "${MUXDIR}/secure" attach
    else
        if [[ ! -d "${MUXDIR}" ]]; then
            mkdir "${MUXDIR}"
        fi
        tmux -S "${MUXDIR}/secure"
    fi
}

smux-lock() {
    local MUXDIR="~/.tmux-sessions"
    chmod 000 "${MUXDIR}"
    sudo chattr +i "${MUXDIR}"
    sudo -k
}
