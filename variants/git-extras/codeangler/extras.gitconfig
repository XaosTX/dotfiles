# Git extras: codeangler (shared settings). Identity, includeIf and credential helpers are per machine.
# User info
[alias]
	# Log display with train tracks, commit, message, committer, and time
	l = log --graph --pretty=format':%C(yellow)%h%Cblue%d%Creset %s %C(white) %an, %ar%Creset'
	# Alternate log display with train tracks, commit, short message, initials, and time. From Scott Chacon
	lol = log --pretty=oneline --abbrev-commit --graph --decorate
	# Remove staged changes
	unstage = reset HEAD
	# See the changes ready to be committed
	staged = diff --cached
	# See changes since last commit
	unstaged = diff
	# See current branch
	current-branch = !git symbolic-ref -q HEAD | sed -e 's|^refs/heads/||'
	pwip = push -u -o merge_request.create -o merge_request.target=master -o merge_request.label=\"workflow::in-progress\"

[core]
  # Set global .gitignore file
  filemode = false

	#   editor = vim

# Enable color highlights in git prompt
[color]
	status = auto
	branch = auto
	interactive = auto
	diff = auto
	ui = true

[fetch]
    prune = true
[init]
    defaultBranch = master
# Set the style of push to servers
[push]
	default = simple

# Kaleidoscope integration
# [difftool "Kaleidoscope"]
# 	cmd = ksdiff --partial-changeset --relative-path \"$MERGED\" -- \"$LOCAL\" \"$REMOTE\"
# [diff]
